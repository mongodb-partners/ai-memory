# MongoDB Atlas connection string (required)
MONGODB_CONNECTION_STRING=mongodb+srv://user:password@cluster.mongodb.net/agent_memory

# MongoDB database name (default: agent_memory)
# MONGODB_DATABASE_NAME=agent_memory

# ── Providers ────────────────────────────────────────────────────────────────
# Embedding provider: "bedrock" (default) | "voyage" | "openai"
# EMBEDDING_PROVIDER=bedrock
# LLM provider:       "bedrock" (default) | "openai" | "anthropic"
# LLM_PROVIDER=bedrock

# AWS Bedrock credentials (required for the default bedrock providers)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1

# Bedrock LLM (LLM_PROVIDER=bedrock). Use an inference-profile id, not a bare
# model id — the newest Claude models are only invocable through a profile.
#   global.*  routes worldwide (widest capacity)
#   us.*      keeps inference in US regions
# Any current Claude works; sampling parameters that a given model rejects are
# detected from its own error and dropped automatically.
# LLM_MODEL=global.anthropic.claude-sonnet-5
#   also valid: global.anthropic.claude-opus-5
#               global.anthropic.claude-sonnet-4-6
#               global.anthropic.claude-haiku-4-5-20251001-v1:0

# Voyage AI embeddings (EMBEDDING_PROVIDER=voyage).
# VOYAGE_API_KEY=your-voyage-api-key
# Endpoint is selectable — both are supported:
#   Public Voyage API (default):
#   VOYAGE_BASE_URL=https://api.voyageai.com/v1/embeddings
#   MongoDB Atlas embeddings gateway (use the MongoDB-issued key):
#   VOYAGE_BASE_URL=https://ai.mongodb.com/v1/embeddings
# voyage-3 emits 1024 dims; embedding_dimension auto-aligns to the model.
# VOYAGE_MODEL=voyage-3

# OpenAI (EMBEDDING_PROVIDER=openai and/or LLM_PROVIDER=openai). pip install agent-memory[openai]
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=                # set to a Grove/compatible gateway if used
# OPENAI_MODEL=gpt-4o
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small   # 1536 (-3-large = 3072)

# Anthropic (LLM_PROVIDER=anthropic; no embeddings). pip install agent-memory[anthropic]
# ANTHROPIC_API_KEY=ak-...
# ANTHROPIC_BASE_URL=             # set to a Grove/compatible gateway if used
# ANTHROPIC_MODEL=claude-sonnet-5

# ── Transport (deployed shells) ──────────────────────────────────────────────
# TRANSPORT=mcp (default) | rest | both
# PORT=8000
# Address to bind. Default 127.0.0.1 — reachable from this host only. Set
# 0.0.0.0 to accept connections from the network (required inside a container);
# the runner then refuses to start unless auth is on, or you assert the risk
# below. docker-compose.yml sets this for you.
# HOST=127.0.0.1

# ── Lifecycle ────────────────────────────────────────────────────────────────
# Run enrichment/consolidation/audit-flush workers in-process (default true).
# False hands reactive work to an external runtime (SP1) — queues go undrained.
# WORKERS_IN_PROCESS=true
# Block create() until Atlas Search indexes are queryable. Recommended for
# short-lived library/script use; leave false for long-running servers.
# AWAIT_SEARCH_INDEXES=false
# Proceed when the embedding dimension changed and vectors are already stored at
# the old width. Startup refuses by default: rebuilding a vector index at a new
# numDimensions does not re-embed the documents beneath it, so those vectors stop
# being returned by $vectorSearch — silently, with no error and no change in
# document count — and recovering needs the provider config you just replaced.
# Set this only after reading the refusal and accepting the loss.
# ALLOW_EMBEDDING_DIMENSION_CHANGE=false

# ── Retention ────────────────────────────────────────────────────────────────
# Each of these sets an Atlas TTL index, reconciled on every startup: change a
# value, restart, and the index is rebuilt at the new duration. Documents already
# past the new cutoff are expired by the TTL monitor within a minute or two of
# the rebuild, so shortening a retention deletes history — check the value before
# restarting a deployment you care about.
#
# How long a soft-deleted memory is kept before it is purged for good.
# SOFT_DELETE_PURGE_DAYS=30
# How long a logged turn is kept. High-volume; loses value fast.
# set_activity_retention changes this at runtime, but only until the next restart.
# EPISODIC_RETENTION_DAYS=30
# How long a semantic-cache entry stays eligible for a hit.
# CACHE_TTL_SECONDS=3600
# How long audit records are kept. Check this against whatever retention
# obligation applies to you before shortening it.
# AUDIT_RETENTION_DAYS=365
# How long a spent rate-limit window counter is kept. Raised to
# RATE_LIMIT_WINDOW_SECONDS if that is longer, since a counter that expires
# inside its own window stops the limit being enforced for the rest of it.
# RATE_LIMIT_RETENTION_SECONDS=86400
#
# Long-term retention is per-tier and applied as a per-document `expires_at`
# rather than a collection-wide TTL, so these are durations in days per tier:
# LTM_RETENTION_CRITICAL_DAYS=365
# LTM_RETENTION_REFERENCE_DAYS=180
# LTM_RETENTION_STANDARD_DAYS=90
# LTM_RETENTION_TEMPORARY_DAYS=7
# STM_TTL_HOURS=24

# ── Auth (optional, disabled by default) ─────────────────────────────────────
# Off is the right default for the library used in-process by a single-tenant
# app: the calling app has already authenticated its user. It is the wrong
# default for a shell on a routable port, where it means every caller names the
# user_id it acts as — so `run()` refuses that combination rather than serving
# it. See ALLOW_UNAUTHENTICATED_NETWORK_ACCESS below.
# AUTH_ENABLED=true
# AUTH_SECRET=your-jwt-signing-secret-at-least-32-bytes
# AUTH_TOKEN_EXPIRY_SECONDS=86400
# MEMORY_MCP_API_KEYS=key1=user1@company.com,key2=user2@company.com
#
# Serve a routable address with auth off anyway — an internal deployment behind
# its own gateway. Logs a warning on every start. Any client that can reach the
# port can read or permanently erase any user's memories.
# ALLOW_UNAUTHENTICATED_NETWORK_ACCESS=false
#
# The inverse assertion: refuse to start at all without auth, whatever else the
# flags say. For deployments where unauthenticated access is never acceptable.
# REQUIRE_AUTH_FOR_MULTI_TENANT=false

# ── Governance / rate limiting (optional, disabled by default) ───────────────
# GOVERNANCE_ENABLED=true
# RATE_LIMIT_ENABLED=true
